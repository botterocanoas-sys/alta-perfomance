# Banco de dados Postgres. Na Neon, copie a "Connection string" do painel.
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Segredo usado para assinar o cookie de sessão.
# Gere um novo com: openssl rand -base64 32
SESSAO_SECRET="troque-por-uma-chave-aleatoria-de-32-bytes"

# Fuso usado para decidir a que dia pertence uma importação.
TZ="America/Sao_Paulo"
