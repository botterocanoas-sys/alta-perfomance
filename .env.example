# Banco de dados Postgres. Na Neon, copie a "Connection string" do painel.
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# Fuso usado para decidir a que dia pertence uma importação.
TZ="America/Sao_Paulo"

# Banco separado para os testes. O nome PRECISA terminar em "_test": o script
# de limpeza se recusa a apagar qualquer outro. Não é usado em produção.
DATABASE_URL_TEST="postgresql://usuario:senha@localhost:5433/alta_test"
